{
    "name": "peanutgraphic/peanut-booker",
    "description": "Peanut Booker \u2014 WordPress booking plugin for performers.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0",
        "peanut/formflow-core": "^0.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:property": "phpunit -c phpunit.property.xml",
        "test:security-core": "phpunit -c phpunit.security-core.xml",
        "test:contract-wp": "phpunit -c phpunit.contract-wp.xml"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Peanut-Graphic/formflow-core.git"
        }
    ]
}
