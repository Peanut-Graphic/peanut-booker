<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dedicated config for the property suite (net 6).
  Runs the pure-function property tests in isolation with a minimal bootstrap
  (no WordPress boot, no legacy unit mocks). Kept fast + deterministic.

  PHPUnit 9.6 schema: the WordPress test library aborts under PHPUnit 10, so the
  whole repo is pinned to phpunit ^9.6 (see composer.json + wp-contract.yml). This
  config therefore targets the 9.x schema/attributes.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/Property/bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    failOnRisky="true"
    failOnWarning="true"
    cacheResultFile=".phpunit.cache/property.result"
>
    <testsuites>
        <testsuite name="Property">
            <directory suffix="Test.php">tests/Property</directory>
        </testsuite>
    </testsuites>

</phpunit>
